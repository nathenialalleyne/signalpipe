# Required
APP_PASSWORD=                 # sign-in password for the web app
SECRET_KEY=                   # any long random string
DOMAIN=                       # e.g. leads.yourdomain.com (used by docker-compose for HTTPS)

# Claude: scoring, message drafting, reply drafting, content plans
ANTHROPIC_API_KEY=
# SIGNALPIPE_MODEL=claude-opus-5-5   # default. claude-haiku-5-5 is far cheaper for high lead volumes.

# Outgoing email through your own mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
EMAIL_DAILY_CAP=30
POSTAL_ADDRESS=               # required in commercial email under US law

# Reply detection (defaults to the SMTP user and password)
IMAP_HOST=
# IMAP_USER=
# IMAP_PASS=

# LinkedIn through Unipile (optional). After setting these two, press Connect LinkedIn in Settings.
UNIPILE_DSN=                  # e.g. api8.unipile.com:13851
UNIPILE_API_KEY=
LINKEDIN_DAILY_CAP=20
LINKEDIN_WEEKLY_CAP=80
LINKEDIN_NOTE_MAX=200         # 300 on paid LinkedIn accounts
LINKEDIN_TZ=America/New_York

# Optional paid lookups
HUNTER_API_KEY=               # named contacts and mailbox verification
TWILIO_ACCOUNT_SID=           # carrier line-type lookup for phone numbers
TWILIO_AUTH_TOKEN=
GITHUB_TOKEN=                 # raises the GitHub stargazer source from 60 to 5000 calls an hour
# SMTP_PROBE=1                # verify mailboxes directly; needs outbound port 25, which most clouds block

# For the MCP server and scripts
API_TOKEN=
RUN_INTERVAL_HOURS=12
